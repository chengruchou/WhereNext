# Copy to backend/.env and fill in. Never commit the real file.

# Claude API: reads requests and writes the checked explanations.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Routes API key for road routes on the map (server-side; no referrer restriction).
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Model files; see the README for the full list of WHERENEXT_* settings.
# WHERENEXT_MODEL_CHECKPOINT=backend/model_core/MG-DSGAT/checkpoints/weight.pt
# WHERENEXT_SEMANTIC_EMBEDDING_PATH=backend/model_core/MG-DSGAT/artifact/Gowalla/poi_semantic_embeddings.pt
# WHERENEXT_DEVICE=cpu
