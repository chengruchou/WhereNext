# Copy to frontend/.env and fill in. Never commit the real file.

# Maps JavaScript API key for the map (restrict it to your site's HTTP referrers).
VITE_GOOGLE_API_KEY=your_google_maps_api_key

# Optional: a vector map ID from the same Google Cloud project as the key.
# VITE_GOOGLE_MAP_ID=your_map_id

VITE_API_BASE_URL=http://127.0.0.1:5000/api
